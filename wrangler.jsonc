{
  // Cloudflare Worker: serves /public as static files and /api/* from src/index.ts.
  "name": "arabic-llm-arena",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arena",
      // Replace with the id printed by `wrangler d1 create arena` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Any OpenAI-compatible endpoint works for HUMAIN (direct API or ALLaM on Azure AI Foundry).
    "HUMAIN_BASE_URL": "",
    "HUMAIN_MODEL": "allam",
    "HUMAIN_AUTH_STYLE": "bearer",
    "HUMAIN_PRICE_IN": "0",
    "HUMAIN_PRICE_OUT": "0",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODEL": "gpt-5-mini",
    "OPENAI_PRICE_IN": "0.25",
    "OPENAI_PRICE_OUT": "2.00",
    "JUDGE_MODEL": "gpt-5-mini"
  }
  // Secrets (never commit): wrangler secret put HUMAIN_API_KEY / OPENAI_API_KEY
}
